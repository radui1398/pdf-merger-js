{
  "name": "pdf-merger-js-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "web",
    "node"
  ],
  "scripts": {
    "standard": "standard",
    "standard:fix": "standard --fix",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest --detectOpenHandles",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch --forceExit --detectOpenHandles",
    "test:types": "tsc -p test/types/tsconfig.json",
    "test:package": "node scripts/test-packages.js",
    "docs:generate": "npm run build && node scripts/generate-llms.js",
    "docs:check": "npm run build && node scripts/generate-llms.js --check",
    "typecheck": "npm run build && npm run test:types",
    "build": "tsc -p web/tsconfig.json && tsc -p node/tsconfig.json",
    "pretest": "npm run build",
    "release:prepare": "npm run docs:check && npm run typecheck && npm run standard && npm test && node scripts/prepare-release.js",
    "release:verify": "node scripts/publish-release.js release-artifacts --dry-run"
  },
  "standard": {
    "env": [
      "jest",
      "browser"
    ],
    "ignore": [
      "web/dist/**",
      "node/dist/**"
    ]
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.11",
    "@types/node": "^22.20.5",
    "fs-extra": "^11.4.1",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jsdom": "^30.1.3",
    "pdfjs-dist": "^6.4.299",
    "standard": "^17.1.2",
    "typescript": "^7.0.2"
  }
}
