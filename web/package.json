{
  "description": "merge multiple PDF documents, or parts of them, to a new PDF document",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/radui1398/pdf-merger-js.git",
    "directory": "web"
  },
  "keywords": [
    "pdf",
    "merge"
  ],
  "author": "nbesli",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/radui1398/pdf-merger-js/issues"
  },
  "homepage": "https://github.com/radui1398/pdf-merger-js#readme",
  "name": "@radui1398/pdf-merger-js",
  "version": "6.0.1",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "browser": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./web": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "llms.txt",
    "llms-full.txt"
  ],
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.1"
  },
  "scripts": {
    "prepack": "npm --prefix .. run build --silent && node ../scripts/generate-llms.js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
